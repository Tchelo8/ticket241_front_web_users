# Adresse centrale de l'API (lue par src/api/apiService.ts → API_BASE_URL).
# En dev, garder « /api » : le proxy Vite relaie vers VITE_API_PROXY (évite le CORS).
# En prod, mettre l'adresse de l'API Gateway, ex. https://api.ticket241.ga/api
VITE_API_URL=/api

# Cible du proxy de dev : la Gateway.
VITE_API_PROXY=http://localhost:8080

# Branchement progressif : domaines servis par l'API réelle, séparés par des virgules
# (events, cities, tickets, payments, auth, signup, organizers). Les autres restent sur le faux serveur.
VITE_LIVE_API=auth,events,cities

# false : TOUT passe par l'API réelle (ignore VITE_LIVE_API).
VITE_USE_MOCKS=true
