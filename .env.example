# Adresse centrale de l'API (lue par src/api/apiService.ts → API_BASE_URL).
# En dev, garder « /api » : le proxy Vite relaie vers VITE_API_PROXY (évite le CORS).
# En prod, mettre l'adresse de l'API Gateway, ex. https://api.ticket241.ga/api
VITE_API_URL=/api

# Cible du proxy de dev : la Gateway.
VITE_API_PROXY=http://localhost:8080
